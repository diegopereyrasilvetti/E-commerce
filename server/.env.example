# Copiá este archivo como .env y completalo. El archivo .env NO se sube a git.

# URL de tu proyecto de Supabase (Project Settings -> API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave SECRET de Supabase (Project Settings -> API Keys -> Secret keys). Da acceso total a tu base de datos:
# no la pongas en el frontend, no la subas a git ni la compartas.
SUPABASE_SECRET_KEY=sb_secret_...

# Puerto del servidor (opcional)
PORT=3001

# Sitios que pueden llamar a la API desde el navegador, separados por coma
CORS_ORIGINS=http://localhost:5173

# Poné true para que la API acepte pedidos (por defecto no: el sitio es de demostración)
PEDIDOS_HABILITADOS=false
