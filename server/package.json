{
  "name": "kodex-api",
  "private": true,
  "version": "1.0.0",
  "description": "API REST de Kodex Tech Store (Node.js + Express + Supabase)",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "cargar-productos": "node --env-file=.env scripts/cargar-productos.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
