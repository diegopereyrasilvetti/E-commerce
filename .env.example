# Copiá este archivo como .env.local y completá los valores (Supabase -> Project Settings -> API Keys).
# Usá la clave "publishable" (o "anon"). NUNCA pongas acá la clave "secret" / "service_role".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Dirección de la API. En desarrollo se deja vacía (Vite redirige /api al servidor local).
# En producción: la dirección del servidor publicado, sin barra al final.
# VITE_API_URL=https://kodex-api.onrender.com
